# OntoFlow v1.3.8 Demo fresh PostgreSQL deployment.
# Preferred: python3 -m scripts.init_fresh_env
# This template is NOT ready to start until PG_PASSWORD is replaced.
# Demo disables internal API/admin key checks and deployment host/HTTPS policy.
# Use only on a trusted local host; remote credentials and URL syntax still apply.
APP_ENV=production
ONTOFLOW_DEMO_MODE=true
ONTOFLOW_FRESH_ONLY=1
DATA_DIR=/app/data
COMPOSE_PROJECT_NAME=ontoflow-fresh
BIND_ADDRESS=127.0.0.1
PORT=8001
PG_DB=ontoflow
PG_USER=ontoflow
PG_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_SECRET
PG_POOL_SIZE=8
WORKER_CONCURRENCY=2
LLM_MAX_CONCURRENCY=2
EXTRACTION_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
MAX_UPLOAD_MB=20
CORS_ORIGINS=
# Configure LLM and OpenMind endpoint/account in the web UI after startup.
# No SQLite path, migration flag or old database is needed.

# Demo ignores deployment/page allowlists and permits HTTP or HTTPS directly.
# No MODEL_ALLOWED_HOSTS, OPENMIND_ALLOWED_HOSTS, or OPENMIND_ALLOW_INSECURE_HTTP is needed.
# Only when explicitly switching ONTOFLOW_DEMO_MODE=false:
# MODEL_ALLOWED_HOSTS=models.example.com
# OPENMIND_ALLOWED_HOSTS=openmind.example.com
# OPENMIND_ALLOW_INSECURE_HTTP=false

# Optional: enable only after confirming your model provider supports this format.
# off (default), json_object, or json_schema. Unsupported providers fail visibly.
LLM_STRUCTURED_OUTPUT=off

# Per semantic response token budget; oversized output is split, not blindly repeated.
LLM_SEMANTIC_MAX_TOKENS=4096
